PORT=5000
# MongoDB Atlas (free M0) ya local: mongodb://127.0.0.1:27017/travel_booking
MONGO_URI=mongodb://127.0.0.1:27017/travel_booking
JWT_SECRET=change-this-to-a-long-random-string
# Frontend URL(s), comma separated
CORS_ORIGIN=http://localhost:5173

# mock = built-in sandbox gateway (demo safe) | razorpay = Razorpay TEST keys
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional AI itinerary (stretch). Khaali chhodo to template itinerary milegi
ANTHROPIC_API_KEY=
ITINERARY_MODEL=claude-sonnet-5-5

# Public URL of the frontend (used inside the e-ticket QR code). Deploy ke baad Vercel URL daalo
FRONTEND_URL=http://localhost:5173

# Optional email confirmation (Gmail: App Password use karo). Khaali chhodo to email skip hota hai
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
